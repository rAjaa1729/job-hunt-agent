# Which AI provider call_llm() should use: "cloudflare" or "ollama"
LLM_PROVIDER=cloudflare

# Only needed if LLM_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_API_TOKEN=your-api-token-here

# Only needed if LLM_PROVIDER=ollama - defaults shown are usually fine
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
